{
	"name": "@ux-patterns/ui",
	"version": "0.1.0",
	"description": "Shared UI components for UX Patterns Kit - compatible with shadcn/ui and Magic UI",
	"type": "module",
	"exports": {
		"./lib/utils": "./src/lib/utils.ts",
		"./utils/*": "./src/utils/*.ts",
		"./components/shadcn/*": "./src/components/shadcn/*.tsx",
		"./components/magicui/*": "./src/components/magicui/*.tsx",
		"./components/custom/*": "./src/components/custom/*.tsx",
		"./components/fumadocs/*": "./src/components/fumadocs/*.tsx",
		"./constants/urls": "./src/constants/urls.ts",
		"./styles/globals.css": "./src/styles/globals.css"
	},
	"scripts": {
		"lint": "biome lint .",
		"check": "tsc --noEmit",
		"check:type": "tsc --noEmit",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@fuma-translate/react": "^1.0.2",
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-aspect-ratio": "^1.1.15",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@radix-ui/react-use-controllable-state": "^1.2.6",
		"@shikijs/transformers": "^4.5.0",
		"@ux-patterns/analytics": "workspace:*",
		"@ux-patterns/constants": "workspace:*",
		"@ux-patterns/hooks": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"fumadocs-core": "16.16.1",
		"fumadocs-ui": "16.16.1",
		"lucide-react": "^1.52.0",
		"motion": "^14.0.0",
		"next": "16.3.8",
		"next-themes": "^0.4.6",
		"outdent": "^0.8.0",
		"preact-render-to-string": "^6.8.0",
		"react-resizable-panels": "^4.14.2",
		"shiki": "^4.5.0",
		"simple-icons": "^16.34.0",
		"tailwind-merge": "^3.7.0",
		"undent": "^1.0.1",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@thedaviddias/config-typescript": "workspace:*",
		"@types/node": "24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/ui": "^4.1.11",
		"eslint": "^10.12.0",
		"jsdom": "^30.1.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
