{
	"name": "@ux-patterns/mcp",
	"version": "2.0.2",
	"description": "MCP server for UX Patterns - exposes patterns, glossary, and decision guides to AI agents",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"ux-patterns-mcp": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js"
		},
		"./tools": {
			"types": "./dist/tools/index.d.ts",
			"import": "./dist/tools/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"import": "./dist/data/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome check .",
		"test": "NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest",
		"test:watch": "NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --watch",
		"test:coverage": "NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --coverage",
		"typecheck": "tsc --noEmit",
		"check:type": "tsc --noEmit",
		"benchmark": "node scripts/benchmark.mjs",
		"eval:tokens": "node --test evals/assertions.test.mjs && PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval --config evals/promptfooconfig.json --no-cache --no-share --no-write --no-table",
		"report:tokens": "node evals/report.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "^2.3.0",
		"@thedaviddias/config-typescript": "workspace:*",
		"@types/jest": "^30.0.0",
		"@types/node": "24.19.1",
		"gpt-tokenizer": "4.0.0",
		"jest": "^30.5.2",
		"promptfoo": "0.123.1",
		"ts-jest": "^29.4.14",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
