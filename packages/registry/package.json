{
	"name": "@ux-patterns/registry",
	"version": "0.1.0",
	"description": "UX Patterns component registry system",
	"type": "module",
	"exports": {
		"./.generated": "./.generated/index.tsx",
		"./lib/registry-generator": "./lib/registry-generator.js"
	},
	"scripts": {
		"check:type": "tsc --noEmit",
		"registry:generate": "npx tsx scripts/build-registry.ts && shadcn build dist/r/registry.json --output dist/r",
		"check": "tsc --noEmit",
		"registry:build": "shadcn build",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@radix-ui/react-slot": "^1.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.52.0",
		"motion": "^14.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@thedaviddias/config-typescript": "workspace:*",
		"@types/node": "24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"chokidar": "^5.0.0",
		"jsdom": "^30.1.2",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"shadcn": "^4.21.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"vitest-axe": "1.0.0-pre.5",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
