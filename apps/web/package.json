{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"analyze": "export ANALYZE=true && next build",
		"prebuild": "node scripts/generate-content-dates.mjs && velite build && node scripts/validate-mermaid.mjs",
		"build": "next build",
		"check": "node -e \"require('node:fs').rmSync('.next/dev/types', { recursive: true, force: true })\" && next typegen && node scripts/validate-mermaid.mjs && node scripts/validate-pattern-structure.mjs && node scripts/validate-pattern-resources.mjs && tsc --noEmit",
		"dev": "portless uxpatterns next dev --turbo -p 3060",
		"dev:velite": "velite --watch",
		"sync:pattern-resources": "node scripts/sync-pattern-resources.mjs",
		"skills:generate": "node scripts/generate-pattern-skills.mjs",
		"glossary:audit": "node scripts/sync-glossary-terms.mjs --mode=audit",
		"glossary:relevance": "node scripts/sync-glossary-terms.mjs --mode=relevance",
		"glossary:sync": "node scripts/sync-glossary-terms.mjs --mode=sync",
		"start": "next start",
		"test": "vitest run",
		"test:glossary-sync": "node --test scripts/glossary-sync-lib.test.mjs",
		"test:mermaid": "node --test scripts/validate-mermaid.test.mjs",
		"test:content-dates": "node --test scripts/content-dates-lib.test.mjs",
		"test:watch": "vitest",
		"test:pattern-structure": "node --test scripts/validate-pattern-structure.test.mjs",
		"test:pattern-resources": "node --test scripts/validate-pattern-resources.test.mjs",
		"test:skills": "node --test scripts/pattern-skills-lib.test.mjs",
		"audit:pattern-resources": "node scripts/audit-pattern-resources.mjs",
		"velite:build": "velite build",
		"postinstall": "fumadocs-mdx",
		"art": "tsx scripts/ux-covers/generator.ts",
		"art:generate-ai": "tsx scripts/ux-covers/generator.ts",
		"art:optimize-ai": "tsx scripts/ux-covers/optimizer.ts",
		"art:render": "tsx scripts/render-pattern-art.tsx",
		"art:scan-ai": "tsx scripts/ux-covers/generator.ts --scan-only",
		"check:type": "next typegen && tsc --noEmit"
	},
	"dependencies": {
		"@codesandbox/sandpack-react": "^2.20.0",
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@next/bundle-analyzer": "^16.3.8",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-aspect-ratio": "^1.1.15",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-presence": "^1.1.10",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-slot": "^1.3.3",
		"@sentry/nextjs": "^11.4.0",
		"@shikijs/engine-javascript": "^4.5.0",
		"@shikijs/engine-oniguruma": "^4.5.0",
		"@ux-patterns/analytics": "workspace:*",
		"@ux-patterns/constants": "workspace:*",
		"@ux-patterns/mcp": "workspace:*",
		"@ux-patterns/newsletter": "workspace:*",
		"@ux-patterns/seo": "workspace:*",
		"@ux-patterns/tracking": "workspace:*",
		"@ux-patterns/ui": "workspace:*",
		"@xyflow/react": "^12.12.0",
		"botid": "^1.5.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dagre": "^0.8.5",
		"date-fns": "^4.4.0",
		"feed": "^6.0.0",
		"fumadocs-core": "16.16.1",
		"fumadocs-mdx": "15.4.6",
		"fumadocs-typescript": "^5.4.1",
		"fumadocs-ui": "16.16.1",
		"gray-matter": "^4.0.3",
		"html-to-image": "^1.11.13",
		"import-in-the-middle": "^3.5.2",
		"lucide-react": "^1.52.0",
		"markdown-to-jsx": "^9.10.3",
		"mermaid": "^12.1.0",
		"motion": "^14.0.0",
		"next": "16.3.8",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"octokit": "^5.0.5",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.14.2",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remove-markdown": "^0.8.0",
		"require-in-the-middle": "^8.0.1",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"ts-morph": "^28.0.0",
		"unified": "^11.0.5",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@orama/orama": "^3.1.18",
		"@shikijs/rehype": "^4.5.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/dagre": "^0.7.54",
		"@types/mdx": "^2.0.14",
		"@types/node": "24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"fast-glob": "^3.3.3",
		"jsdom": "^30.1.2",
		"postcss": "^8.5.28",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-retext": "^6.0.1",
		"retext": "^9.0.0",
		"retext-english": "^5.0.0",
		"retext-keywords": "^8.0.2",
		"retext-pos": "^5.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"velite": "^0.4.0",
		"vitest": "^4.1.11"
	}
}
